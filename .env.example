# ============================================================================
# Variant Image Sync — Environment Configuration
# ============================================================================

# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://your-app-domain.example.com

# Shopify App Handle (Used for Shopify App Pricing URLs:
# https://admin.shopify.com/store/:store_handle/charges/:app_handle/pricing_plans)
SHOPIFY_APP_HANDLE=bulk-variant-update-g-sync

# Shopify App Pricing Plan Handles (Configured in Partner Dashboard -> App -> Monetization / Pricing)
# Default values match standard handle conventions:
SHOPIFY_PLAN_HANDLE_STARTER=starter
SHOPIFY_PLAN_HANDLE_GROWTH=growth
SHOPIFY_PLAN_HANDLE_PRO=pro

# Optional: Shopify Partner API Credentials for Active Subscription Verification
# If omitted, verification automatically queries Admin GraphQL (currentAppInstallation.activeSubscriptions)
# and return-flow verification.
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_APP_ID=

# Database Configuration (Prisma SQLite)
DATABASE_URL="file:dev.sqlite"

# Environment Mode
# In production (NODE_ENV=production), test headers (x-simulate-plan) and STORE_PLAN
# are STRICTLY IGNORED to prevent unauthorized plan simulation.
NODE_ENV=development
